<Project>

	<!-- Every project under engine/ without a Directory.Build.props of its own - all but Tests and Launcher. -->

	<PropertyGroup>
		<!-- Release unless asked: the engine writes into the editor's game/bin/managed, and a stray Debug build left the editor's JIT optimiser off.
		     It has to be here, not in a csproj: the SDK sets Debug before a project's body is read, and unsets it on referenced projects. -->
		<Configuration Condition="'$(Configuration)' == ''">Release</Configuration>

		<!-- English only: Roslyn's thirteen translated satellite folders are seven megabytes beside the engine. -->
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>

		<!-- .NET 11 runtime async: the runtime suspends awaits, not a compiler state machine - fewer allocations, cheaper completed awaits. -->
		<Features>$(Features);runtime-async=on</Features>
	</PropertyGroup>

</Project>
