<Project>

	<!-- Every project under engine/ without a Directory.Build.props of its own - all but Tests and Launcher. -->

	<PropertyGroup>
		<!-- Release unless asked: the engine writes into the editor's game/bin/managed, and a stray Debug build left the editor's JIT optimiser off.
		     It has to be here, not in a csproj: the SDK sets Debug before a project's body is read, and unsets it on referenced projects. -->
		<Configuration Condition="'$(Configuration)' == ''">Release</Configuration>

		<!-- English only: Roslyn's thirteen translated satellite folders are seven megabytes beside the engine. -->
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>

		<!-- What the engine's projects target; the web module's build sets RintenWebModule and gets the other one below. -->
		<RintenFramework>net11.0</RintenFramework>
	</PropertyGroup>

	<!-- .NET 11 runtime async: the runtime suspends awaits, not a compiler state machine - fewer allocations, cheaper completed awaits. -->
	<PropertyGroup Condition="'$(RintenWebModule)' != 'true'">
		<Features>$(Features);runtime-async=on</Features>
	</PropertyGroup>

	<!-- The web module: NativeAOT-LLVM exists only for .NET 10 and cannot compile runtime async, so the engine is built for it
	     a second time, into obj/web and bin/web, leaving the editor's net11 build alone. -->
	<PropertyGroup Condition="'$(RintenWebModule)' == 'true'">
		<RintenFramework>net10.0</RintenFramework>
		<BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj/web/</BaseIntermediateOutputPath>
		<BaseOutputPath>$(MSBuildProjectDirectory)/bin/web/</BaseOutputPath>
		<DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
	</PropertyGroup>

</Project>
