<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../Razor.Targets" />

  <!-- Keeps rintencore.dll in step with the sources it is built from. The other
       launchers can have it with the same line; this is the one F5 runs. -->
  <Import Project="../../Core/NativeCore.targets" />

  <!-- The launcher's panels carry their styles inside the assembly: it never
       mounts a game, so there is no content for a stylesheet url to be found in. -->
  <ItemGroup>
    <EmbeddedResource Include="UI/**/*.razor.scss" />
  </ItemGroup>

	<PropertyGroup>
		<VersionPrefix>1.0.1</VersionPrefix>
		<TargetFramework>net11.0</TargetFramework>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GenerateDocumentationFile>False</GenerateDocumentationFile>
		<AssemblyName>Rinten</AssemblyName>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<NoWarn>1701;1702;1591;NETSDK1138</NoWarn>
		<LangVersion>15</LangVersion>
		<OutputPath>..\..\..\game</OutputPath>
		<OutputType>WinExe</OutputType>
		<DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
		<PreserveCompilationReferences>false</PreserveCompilationReferences>
		<PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
		<PreserveCompilationContext>false</PreserveCompilationContext>
		<GenerateRuntimeConfigDevFile>false</GenerateRuntimeConfigDevFile>
		<StartupObject>Rinten.Program</StartupObject>
		<ProduceReferenceAssembly>False</ProduceReferenceAssembly>
		<DebugType>embedded</DebugType>
		<ApplicationIcon>Rinten.ico</ApplicationIcon>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<CETCompat>false</CETCompat>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Rinten.AppSystem\Rinten.AppSystem.csproj" Private="false"/>
		<ProjectReference Include="..\..\Rinten.Filesystem\Rinten.Filesystem.csproj" Private="false" />
		<ProjectReference Include="..\..\Rinten.System\Rinten.System.csproj" Private="false" />
		<ProjectReference Include="..\..\Rinten.Engine\Rinten.Engine.csproj"  Private="false"/>
		<!-- Razor's own builder type, which the generated markup is written against. -->
		<ProjectReference Include="..\..\Microsoft.AspNetCore.Components\Microsoft.AspNetCore.Components.csproj" Private="false" />
		<ProjectReference Include="..\..\Rinten.GameInstance\Rinten.GameInstance.csproj" Private="false" />
		<ProjectReference Include="..\..\Rinten.Tools\Rinten.Tools.csproj" Private="false" />
		<ProjectReference Include="..\..\Rinten.Code\Rinten.Code.csproj" Private="false" />
	</ItemGroup>

	<Import Project="..\Shared\LaunchShared.projitems" Label="Shared" />
</Project>
