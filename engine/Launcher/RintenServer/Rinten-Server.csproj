<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<VersionPrefix>1.0.1</VersionPrefix>
		<TargetFramework>net11.0</TargetFramework>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GenerateDocumentationFile>False</GenerateDocumentationFile>
		<AssemblyName>Rinten-Server</AssemblyName>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<NoWarn>1701;1702;1591;NETSDK1138</NoWarn>
		<LangVersion>15</LangVersion>
		<OutputPath>..\..\..\game</OutputPath>
		<OutputType>Exe</OutputType>
		<DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
		<PreserveCompilationReferences>false</PreserveCompilationReferences>
		<PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
		<PreserveCompilationContext>false</PreserveCompilationContext>
		<GenerateRuntimeConfigDevFile>false</GenerateRuntimeConfigDevFile>
		<StartupObject>Rinten.Program</StartupObject>
		<ProduceReferenceAssembly>False</ProduceReferenceAssembly>
		<DebugType>embedded</DebugType>
		<ApplicationIcon>Rinten-Server.ico</ApplicationIcon>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<CETCompat>false</CETCompat>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Rinten.AppSystem\Rinten.AppSystem.csproj" Private="false"/>
		<ProjectReference Include="..\..\Rinten.Engine\Rinten.Engine.csproj"  Private="false"/>
		<ProjectReference Include="..\..\Rinten.GameInstance\Rinten.GameInstance.csproj" Private="false" />
		<ProjectReference Include="..\..\Rinten.System\Rinten.System.csproj" Private="false" />
	</ItemGroup>

	<Import Project="..\Shared\LaunchShared.projitems" Label="Shared" />
</Project>
