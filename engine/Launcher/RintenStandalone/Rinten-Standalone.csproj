<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<VersionPrefix>1.0.1</VersionPrefix>
		<TargetFramework>net11.0</TargetFramework>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GenerateDocumentationFile>False</GenerateDocumentationFile>
		<AssemblyName>Rinten-Standalone</AssemblyName>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<NoWarn>1701;1702;1591;NETSDK1138</NoWarn>
		<LangVersion>15</LangVersion>
		<OutputPath>..\..\..\game</OutputPath>
		<OutputType>WinExe</OutputType>
		<DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
		<PreserveCompilationReferences>false</PreserveCompilationReferences>
		<PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
		<PreserveCompilationContext>false</PreserveCompilationContext>
		<GenerateRuntimeConfigDevFile>false</GenerateRuntimeConfigDevFile>
		<StartupObject>Rinten.Program</StartupObject>
		<ProduceReferenceAssembly>False</ProduceReferenceAssembly>
		<DebugType>embedded</DebugType>
		<ApplicationIcon>Rinten-Standalone.ico</ApplicationIcon>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<CETCompat>false</CETCompat>
	</PropertyGroup>

	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
		<OutputType>Exe</OutputType>
		<WasmBuildNative>true</WasmBuildNative>
		<EmccExtraLDFlags>--use-port=emdawnwebgpu --use-port=sdl3 -sASYNCIFY=1 -sALLOW_MEMORY_GROWTH=1 -sENVIRONMENT=web</EmccExtraLDFlags>
	</PropertyGroup>

	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
		<NativeFileReference Include="..\..\..\game\bin\wasm32\rintencore.a" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Rinten.AppSystem\Rinten.AppSystem.csproj" Private="false"/>
		<ProjectReference Include="..\..\Rinten.Engine\Rinten.Engine.csproj"  Private="false"/>
		<ProjectReference Include="..\..\Rinten.System\Rinten.System.csproj" Private="false" />
	</ItemGroup>

	<Import Project="..\Shared\LaunchShared.projitems" Label="Shared" />

</Project>
