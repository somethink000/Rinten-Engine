<Project>

	<!-- Shared settings for every project under engine/Tests/. Test projects get the MSTest packages automatically; fixture projects (support assemblies
	     under Fixtures/) opt out with <IsTestProject>false</IsTestProject>. Package versions are pinned centrally in Directory.Packages.props. -->

	<PropertyGroup>
		<!-- Release unless somebody asks for Debug by name. Rinten.Engine writes to a fixed OutputPath - game/bin/managed, the folder the editor runs from - in every configuration, and these projects reference it. So `dotnet build` here, which defaults to Debug, rebuilt the engine as Debug on top of the Release one and left the editor running with the JIT optimiser off. That was read as a 940 -> 684 fps regression from
		     the core port for most of an evening; the perfreport's conditions block had been saying "build Debug, jit optimiser OFF - this is not a performance measurement" the whole time. It has to be here rather than in the csproj: the SDK gives Configuration its Debug default before a project's own body is read, so a condition in the csproj is already false by the time it runs. Directory.Build.props is imported first. -->
		<Configuration Condition="'$(Configuration)' == ''">Release</Configuration>

		<TargetFramework>net11.0</TargetFramework>
		<NoWarn>1701;1702;1591;CS0612</NoWarn>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsPublishable>false</IsPublishable>
		<IsPackable>false</IsPackable>
		<IsTestProject Condition="'$(IsTestProject)' == ''">true</IsTestProject>
		<!-- Portable pool injects threads too slowly under MSTest MethodLevel parallelism plus Parallel.For -->
		<UseWindowsThreadPool>true</UseWindowsThreadPool>
	</PropertyGroup>

	<ItemGroup Condition="'$(IsTestProject)' == 'true'">
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
		<PackageReference Include="coverlet.collector">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
