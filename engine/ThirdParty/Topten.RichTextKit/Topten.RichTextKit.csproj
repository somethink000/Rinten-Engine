  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../RintenUI/ThirdParty/Topten.RichTextKit/**/*.cs" Exclude="../../RintenUI/ThirdParty/Topten.RichTextKit/obj/**;../../RintenUI/ThirdParty/Topten.RichTextKit/bin/**" />
  </ItemGroup>

</Project>
