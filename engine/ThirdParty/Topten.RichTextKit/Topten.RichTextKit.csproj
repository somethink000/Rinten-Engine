  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Rinten.System\Rinten.System.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../RintenUI/ThirdParty/Topten.RichTextKit/Resources\BidiClasses.trie" LogicalName="Topten.RichTextKit.Resources.BidiClasses.trie" />
