<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Exe</OutputType>
	<TargetFramework>net11.0</TargetFramework>
	<OutputPath>bin</OutputPath>
	<ImplicitUsings>enable</ImplicitUsings>

	<PackAsTool>true</PackAsTool>
	<ToolCommandName>rintenbuild</ToolCommandName>
	<PackageId>rintenbuild</PackageId>
	<PackageOutputPath>./nupkg</PackageOutputPath>
	<Version>1.0.0</Version>
	<AssemblyName>rintenbuild</AssemblyName>
	<RootNamespace>Rinten.Build</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="JetBrains.Refasmer" Version="2.0.3" />
	<PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

   <ItemGroup>
	</ItemGroup>

</Project>