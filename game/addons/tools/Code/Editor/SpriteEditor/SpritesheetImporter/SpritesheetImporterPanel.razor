@namespace Editor.SpriteEditor
@using System
@using System.Collections.Generic
@using System.Linq
@using Rinten.UI
@using Rinten.Rendering
@using Editor.Inspectors
@attribute [StyleSheet( "SpritesheetImporterPanel.razor.scss" )]
@inherits Panel

@* The importer: a title and a way out across the top, the settings that cut the
   sheet into cells down the left with the buttons under them, and the sheet with
   those cells drawn on it to the right. Cells are picked on the sheet - pressed or
   dragged over, and unpicked the same way with the right button. *@

<root class="spritesheet-importer">
	<div class="head">
		<i class="glyph">grid_view</i>
		<label class="title">@Title</label>
		<ToolbarButton Icon="close" ToolTip="Close without importing" OnPressed="@Close" />
	</div>

	<div class="body">
		<div class="side">
			<div class="scroll">
				<ControlSheet @ref="_sheet" />
			</div>

			<div class="buttons">
				<div class="btn" onclick="@ResetSettings"><i>refresh</i><label>Reset All Settings</label></div>
				<div class="btn @( Any ? null : "is-disabled" )" onclick="@ClearSelection"><i>deselect</i><label>Clear Selection</label></div>
				<div class="btn good @( Any ? null : "is-disabled" )" onclick="@Import"><i>download</i><label>@( Any ? Action : "No Frames Selected" )</label></div>
			</div>
		</div>

		<SpritesheetSheetView @ref="_view" class="sheet-view" />
	</div>
</root>

@code
{
	const string SettingsCookie = "SpriteEditor.SpritesheetImporterSettings";

	//The sheet, as a path the mounted filesystem knows.
	public string ImagePath { get; set; }

	//How the sheet is drawn - the same as the sprite editor's preview.
	public FilterMode Filter { get; set; } = FilterMode.Point;

	//What the button that hands the picked cells over says.
	public string Action { get; set; } = "Import Spritesheet";

	//Cells of this size to start from, instead of the last import's settings.
	public Vector2Int? CellSize { get; set; }

	//Given the picked cells as pixel rectangles on the sheet, in the order they were picked.
	public Action<IReadOnlyList<Rect>> OnImport { get; set; }

	public SpritesheetImporterPanel()
	{
		//So escape reaches it.
		AcceptsFocus = true;
	}

	//Leaves without importing.
	void Close() => SpriteEditorModal.Close( this );


	public override void OnButtonTyped( ButtonEvent e )
	{
		base.OnButtonTyped( e );

		if ( e.Pressed && e.Button == "escape" ) Close();
	}

	readonly SpritesheetSelection _selection = new();
	SpritesheetImportSettings _settings;

	ControlSheet _sheet;
	SpritesheetSheetView _view;
	bool _wired;

	string Title => $"Spritesheet - {System.IO.Path.GetFileName( ImagePath ?? "" )}";

	bool Any => _selection.Count > 0;

	protected override int BuildHash() => HashCode.Combine( _selection.Count, Action );

	protected override void OnAfterTreeRender( bool firstTime )
	{
		base.OnAfterTreeRender( firstTime );

		if ( _wired || !_sheet.IsValid() || !_view.IsValid() ) return;
		_wired = true;

		_settings = new SpritesheetImportSettings();

		_view.Settings = _settings;
		_view.Selection = _selection;
		_view.Filter = Filter;

		_selection.Changed += StateHasChanged;

		LoadSheet();
	}

	public override void OnDeleted()
	{
		base.OnDeleted();

		_selection.Changed -= StateHasChanged;
	}

	//The settings

	//Each sheet remembers how it was cut, so reopening it shows what was set rather than a guess.
	string CookieKey => $"{SettingsCookie}.{ImagePath}";

	void Remember() => EditorCookie.Set( CookieKey, _settings );

	//Points the sheet at the settings; every edit is remembered as it is made, not only on import.
	void BindSettings()
	{
		_settings.OnFrameCountChanged = _selection.Clear;

		var target = _settings.GetSerialized();
		target.OnPropertyChanged += _ => Remember();

		_sheet.Target = target;
		_sheet.Rebuild();
	}

	//Back to what the sheet itself suggests, forgetting what was set for it.
	void ResetSettings()
	{
		_settings.OnFrameCountChanged = null;
		_selection.Clear();

		var size = _view.TextureSize;
		Guess( (int)size.x, (int)size.y );

		Remember();
		BindSettings();
	}

	void ClearSelection() => _selection.Clear();

	//The sheet

	//A cell size asked for wins, unless this sheet's saved cut already has it; then the saved cut; then a guess.
	void LoadSheet()
	{
		var texture = Texture.LoadFromFileSystem( ImagePath, FileSystem.Mounted );

		if ( texture is not null )
		{
			_view.SetTexture( texture );

			var saved = EditorCookie.Get<SpritesheetImportSettings>( CookieKey, null );

			if ( CellSize is { x: > 0, y: > 0 } cell && !Cuts( saved, texture.Width, texture.Height, cell ) )
				CutInto( texture.Width, texture.Height, cell );
			else if ( saved is not null )
				_settings.CopyFrom( saved );
			else
				Guess( texture.Width, texture.Height );
		}

		BindSettings();
	}

	//Whether saved settings cut the sheet into cells of this size.
	static bool Cuts( SpritesheetImportSettings saved, int width, int height, Vector2Int cell )
	{
		if ( saved is null ) return false;

		var first = saved.GetFrames( width, height ).FirstOrDefault();

		return (int)first.Width == cell.x && (int)first.Height == cell.y;
	}

	//A sheet cut into cells of one size edge to edge - what a frame that is already
	//one cell of it was cut from. Nothing is picked: the cell is the one to choose.
	void CutInto( int width, int height, Vector2Int cell ) => Lay( width, height, cell, default, default );

	//Cells of a size from a margin with gaps between, the leftover on the right and bottom.
	void Lay( int width, int height, Vector2Int cell, Vector2Int margin, Vector2Int spacing )
	{
		var columns = Math.Max( 1, ( width - margin.x + spacing.x ) / Math.Max( 1, cell.x + spacing.x ) );
		var rows = Math.Max( 1, ( height - margin.y + spacing.y ) / Math.Max( 1, cell.y + spacing.y ) );

		_settings.CopyFrom( new SpritesheetImportSettings
		{
			HorizontalFrames = columns,
			VerticalFrames = rows,
			PaddingLeft = margin.x,
			PaddingTop = margin.y,
			PaddingRight = Math.Max( 0, width - margin.x - columns * cell.x - ( columns - 1 ) * spacing.x ),
			PaddingBottom = Math.Max( 0, height - margin.y - rows * cell.y - ( rows - 1 ) * spacing.y ),
			HorizontalSeparation = spacing.x,
			VerticalSeparation = spacing.y,
		} );
	}

	//A strip - at least twice as long as it is tall, or as tall as it is long - is cut into squares along its length,
	//every one picked. Anything else is cut the way a tile sheet is guessed: a size in its name, gaps, or seams.
	void Guess( int width, int height )
	{
		_settings.CopyFrom( new SpritesheetImportSettings() );

		if ( width <= 0 || height <= 0 ) return;

		var longSide = Math.Max( width, height );
		var shortSide = Math.Min( width, height );

		if ( longSide >= 2 * shortSide )
		{
			var square = new Vector2Int( shortSide, shortSide );
			Lay( width, height, square, default, default );

			_selection.SelectAll( _settings.HorizontalFrames, _settings.VerticalFrames );
			return;
		}

		try
		{
			using var bitmap = Bitmap.CreateFromBytes( FileSystem.Mounted.ReadAllBytes( ImagePath ).ToArray() );
			if ( bitmap is null ) return;

			var grid = Editor.Tiles.TileSheetGuess.Guess( bitmap, System.IO.Path.GetFileNameWithoutExtension( ImagePath ) );

			//No evidence in the picture: the class's own grid is as good a start as a common tile size
			if ( grid.How.Contains( "common size" ) ) return;

			Lay( width, height, grid.Size, grid.Margin, grid.Spacing );
		}
		catch ( Exception e )
		{
			Log.Warning( $"Spritesheet importer: could not read {ImagePath} to guess its grid: {e.Message}" );
		}
	}

	//The picked cells

	void Import()
	{
		if ( _selection.Count == 0 ) return;

		var size = _view.TextureSize;
		var cells = _settings.GetFrames( (int)size.x, (int)size.y );
		var columns = Math.Max( 1, _settings.HorizontalFrames );

		var picked = _selection.InOrder
			.Select( cell => cell.y * columns + cell.x )
			.Where( index => index >= 0 && index < cells.Count )
			.Select( index => cells[index] )
			.ToList();

		Remember();

		OnImport?.Invoke( picked );
	}
}
