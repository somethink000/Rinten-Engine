@using System.Threading
@using Rinten
@using Rinten.UI
@namespace Editor
@attribute [StyleSheet( "BuildPopup.razor.scss" )]
@inherits Popup

<root class="build-popup">
	<div class="body">
		<div class="head">
			<i>wb_iridescent</i>
			<span class="heading">Lighting</span>
		</div>

		@if ( Settings is not null )
		{
			<Editor.Inspectors.ControlSheet Target="@settings" PropertyFilter="@ShownRows" />

			<div class="more" onclick="@ToggleAdvanced">
				<i>@( advanced ? "expand_less" : "expand_more" )</i>
				<label>@( advanced ? "Fewer settings" : "More settings" )</label>
			</div>
		}

		<div class="status">
			<i class="@( baking is not null ? "busy" : Baked ? "done" : "" )">@( baking is not null ? "hourglass_top" : Baked ? "check_circle" : "radio_button_unchecked" )</i>
			<label>@Status</label>
		</div>

		<div class="buttons">
			@if ( baking is not null )
			{
				<div class="button" onclick="@Cancel"><i>close</i><label>Cancel</label></div>
			}
			else
			{
				<div class="button @( Baked ? "" : "disabled" )" onclick="@Clear"><i>delete</i><label>Clear</label></div>
				<div class="button primary" onclick="@Bake"><i>lightbulb</i><label>Bake Lighting</label></div>
			}
		</div>
	</div>
</root>

@code
{
	/// <summary>The view whose scene this builds.</summary>
	public SceneViewPanel SceneView { get; set; }

	BakedLighting lighting;
	SerializedObject settings;
	CancellationTokenSource baking;
	bool advanced;

	//The scene being edited, not a game played from it
	Scene EditedScene => SceneView?.TabSession?.Scene;

	BakedLighting Lighting => EditedScene.IsValid() ? EditedScene.Lighting : null;

	//The bake's settings as rows; an edit leaves the scene to be saved
	SerializedObject Settings
	{
		get
		{
			if ( Lighting is not { } now ) return null;
			if ( ReferenceEquals( now, lighting ) ) return settings;

			lighting = now;
			settings = Game.TypeLibrary.GetSerializedObject( now );
			settings.OnPropertyChanged += _ =>
			{
				if ( now.Scene.Editor is { } editor ) editor.HasUnsavedChanges = true;
			};

			return settings;
		}
	}

	bool Baked => Lighting is { HasBake: true };

	//No model or mesh in the scene is marked Static, so a bake has nothing to work on
	bool NothingStill => EditedScene is { } scene
		&& !scene.GetAllComponents<ModelRenderer>().Any( r => r.GameObject.IsStatic )
		&& !scene.GetAllComponents<MeshComponent>().Any( m => m.GameObject.IsStatic );

	string Status
	{
		get
		{
			if ( baking is not null ) return "Baking - progress is at the bottom of the editor";
			if ( Lighting?.Data is not { IsEmpty: false } data )
				return NothingStill ? "Not baked - only objects marked Static are baked, and none are" : "Not baked";

			var sheet = data.HasSheet ? $"{data.SheetWidth}x{data.SheetHeight} atlas" : "no atlas";
			var volume = data.HasVolume ? $"{data.VolumeX}x{data.VolumeY}x{data.VolumeZ} volume" : "no volume";

			return $"Baked: {sheet}, {volume}";
		}
	}

	/// <summary>Opens the panel under the button that asked for it.</summary>
	public static BuildPopup Open( Panel anchor, SceneViewPanel view )
	{
		if ( anchor is null || !anchor.IsValid() ) return null;

		var popup = new BuildPopup { SceneView = view };
		popup.SetPositioning( anchor, PositionMode.BelowCenter, 4 );
		popup.AnchorPanel = anchor;
		popup.CloseWhenParentIsHidden = true;
		popup.AddClass( "editor-popup" );
		popup.SyncAnchor();

		return popup;
	}

	//The main settings always; the Advanced group once asked for
	bool Shown( SerializedProperty property ) => advanced || property.GroupName != "Advanced";

	Func<SerializedProperty, bool> ShownRows => Shown;

	void ToggleAdvanced()
	{
		advanced = !advanced;
		StateHasChanged();
	}

	//Async void as a click handler: everything it can throw is caught here
	async void Bake()
	{
		if ( baking is not null || Lighting is not { } target ) return;

		baking = new CancellationTokenSource();
		StateHasChanged();

		try
		{
			await target.Bake( baking.Token );
		}
		catch ( OperationCanceledException )
		{
		}
		catch ( Exception e )
		{
			Log.Warning( $"baked lighting: the bake failed - {e.Message}" );
		}
		finally
		{
			baking.Dispose();
			baking = null;
			StateHasChanged();
		}
	}

	void Cancel() => baking?.Cancel();

	void Clear()
	{
		if ( Lighting is { HasBake: true } target ) target.Clear();
		StateHasChanged();
	}

	protected override int BuildHash() => HashCode.Combine( Lighting, baking is not null, Lighting?.Data, advanced );
}
