@using System.Threading
@using Rinten
@using Rinten.Navigation
@using Rinten.UI
@using Editor.Inspectors
@namespace Editor
@attribute [StyleSheet( "BuildPopup.razor.scss" )]
@inherits Popup

<root class="build-popup">
	<div class="body">
		<div class="head">
			<i>wb_iridescent</i>
			<span class="heading">Lighting</span>
		</div>

		<div class="buttons">
			@if ( baking is not null )
			{
				<div class="button wide" onclick="@Cancel"><i>close</i><label>Cancel</label></div>
			}
			else
			{
				<div class="button wide primary @( NothingToBake ? "disabled" : "" )" onclick="@Bake"><i>lightbulb</i><label>Bake Scene</label></div>
			}
		</div>

		<div class="status">
			<i class="@( baking is not null ? "busy" : Baked ? "done" : "" )">@( baking is not null ? "hourglass_top" : Baked ? "check_circle" : "radio_button_unchecked" )</i>
			<label>@Status</label>
		</div>

		<div class="cards" @ref="Cards"></div>
	</div>
</root>

@code
{
	/// <summary>The view whose scene this builds.</summary>
	public SceneViewPanel SceneView { get; set; }

	Panel Cards;
	BakedLighting laid;
	CancellationTokenSource baking;

	//The scene being edited, not a game played from it
	Scene EditedScene => SceneView?.TabSession?.Scene;

	BakedLighting Lighting => EditedScene.IsValid() ? EditedScene.Lighting : null;

	NavMesh Navigation => EditedScene.IsValid() ? EditedScene.NavMesh : null;

	bool Baked => Lighting is { HasBake: true } || Lighting?.Envmaps.Asset is { Data.Pictures.Count: > 0 } || Navigation is { HasBake: true };

	bool NothingToBake => Lighting is not { } lighting
		|| ( !lighting.Lightmaps.Bake && !lighting.Envmaps.Bake && Navigation is not { IsEnabled: true } );

	//No model or mesh in the scene is marked Static, so the lightmaps have nothing to work on
	bool NothingStill => EditedScene is { } scene
		&& !scene.GetAllComponents<ModelRenderer>().Any( r => r.GameObject.IsStatic )
		&& !scene.GetAllComponents<MeshComponent>().Any( m => m.GameObject.IsStatic );

	string Status
	{
		get
		{
			if ( baking is not null ) return "Baking - progress is at the bottom of the editor";
			if ( Lighting is not { } lighting ) return "";

			var lightmap = lighting.Data is { IsEmpty: false } data && data.HasSheet ? $"{data.SheetWidth}² lightmap"
				: NothingStill ? "no lightmap - nothing is marked Static" : "no lightmap";

			var probes = lighting.Envmaps.Asset?.Data.Pictures.Count ?? 0;
			var envmaps = probes > 0 ? $"{probes} envmap{( probes == 1 ? "" : "s" )}" : "no envmaps";

			var navigation = Navigation is { HasBake: true } ? "navmesh" : "no navmesh";

			return $"{lightmap}, {envmaps}, {navigation}";
		}
	}

	/// <summary>Opens the panel under the button that asked for it.</summary>
	public static BuildPopup Open( Panel anchor, SceneViewPanel view )
	{
		if ( anchor is null || !anchor.IsValid() ) return null;

		var popup = new BuildPopup { SceneView = view };
		popup.SetPositioning( anchor, PositionMode.BelowCenter, 4 );
		popup.AnchorPanel = anchor;
		popup.CloseWhenParentIsHidden = true;
		popup.AddClass( "editor-popup" );
		popup.SyncAnchor();

		return popup;
	}

	//A card each, as a component is one: its switch says whether Bake Scene bakes it - for the navmesh, whether the scene has one
	protected override void OnAfterTreeRender( bool firstTime )
	{
		base.OnAfterTreeRender( firstTime );

		if ( Cards is null || ReferenceEquals( laid, Lighting ) ) return;

		laid = Lighting;
		Cards.DeleteChildren( true );

		if ( laid is null ) return;

		var scene = laid.Scene;

		Card( "Lightmaps", "wb_iridescent", laid.Lightmaps, nameof( BakedLighting.LightmapSettings.Bake ) );
		Card( "Envmaps", "panorama_photosphere", laid.Envmaps, nameof( BakedLighting.EnvmapSettings.Bake ) );

		//A changed setting is a navmesh to build again
		Card( "NavMesh", "directions_run", scene.NavMesh, nameof( NavMesh.IsEnabled ) ).OnPropertyChanged += _ => scene.NavMesh.SetDirty();
	}

	SerializedObject Card( string title, string icon, object block, string toggle )
	{
		var so = Game.TypeLibrary.GetSerializedObject( block );
		var scene = laid.Scene;

		//An edit leaves the scene to be saved
		so.OnPropertyChanged += _ =>
		{
			if ( scene.Editor is { } editor ) editor.HasUnsavedChanges = true;
		};

		var card = Cards.AddChild( new InspectorCard( title, icon, so.GetProperty( toggle ), $"bake.{title.ToLowerInvariant()}" ) );
		card.Body.AddChild( new Editor.Inspectors.ControlSheet { Target = so, PropertyFilter = x => x.Name != toggle } );
		card.Refold();

		return so;
	}

	//Async void as a click handler: everything it can throw is caught here
	async void Bake()
	{
		if ( baking is not null || NothingToBake || Lighting is not { } target ) return;

		baking = new CancellationTokenSource();
		StateHasChanged();

		try
		{
			await target.Bake( baking.Token );

			if ( !baking.IsCancellationRequested && target.Scene.NavMesh.IsEnabled )
				await target.Scene.NavMesh.Bake( target.Scene, baking.Token );
		}
		catch ( OperationCanceledException )
		{
		}
		catch ( Exception e )
		{
			Log.Warning( $"baked lighting: the bake failed - {e.Message}" );
		}
		finally
		{
			baking.Dispose();
			baking = null;
			StateHasChanged();
		}
	}

	void Cancel() => baking?.Cancel();

	protected override int BuildHash() => HashCode.Combine( Lighting, baking is not null, Lighting?.Data, Lighting?.Envmaps.Asset?.Data,
		Lighting?.Lightmaps.Bake, Lighting?.Envmaps.Bake, Navigation?.IsEnabled, Navigation?.HasBake );
}
